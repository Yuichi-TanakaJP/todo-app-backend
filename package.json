{
  "name": "todo-app-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/write-native-ca.mjs && node scripts/check-native-runtime.mjs",
    "prisma:migrate": "prisma migrate deploy",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:db": "npm run build && node --test tests/prisma7.integration.mjs tests/startup.integration.mjs",
    "test:tls": "npm run build && node --test tests/prisma-tls.integration.mjs",
    "db:check-config": "tsx scripts/check-database-config.ts",
    "test:binding": "npm run build && node --test tests/channel-binding.integration.mjs tests/native-timeout.integration.mjs tests/native-types.integration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "optionalDependencies": {
    "pg-native": "3.9.1"
  }
}
